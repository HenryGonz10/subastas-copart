// Modelo de datos - Subastas de vehículos estilo Copart
// Motor: SQL Server (local con Docker, producción con Azure SQL Database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuarios
// ---------------------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  firstName    String   @db.NVarChar(80)
  lastName     String   @db.NVarChar(80)
  email        String   @unique @db.NVarChar(160)
  phone        String   @db.NVarChar(30)
  passwordHash String   @db.NVarChar(100)
  createdAt    DateTime @default(now())

  vehicles      Vehicle[] @relation("VehicleOwner")
  leadingBids   Vehicle[] @relation("VehicleCurrentBidder")
  bids          Bid[]

  @@map("Users")
}

// ---------------------------------------------------------------------------
// Catálogos
// ---------------------------------------------------------------------------

model ItemType {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.NVarChar(60)
  vehicles Vehicle[]

  @@map("ItemTypes")
}

model Make {
  id       Int            @id @default(autoincrement())
  name     String         @unique @db.NVarChar(60)
  models   VehicleModel[]
  vehicles Vehicle[]

  @@map("Makes")
}

model VehicleModel {
  id       Int       @id @default(autoincrement())
  makeId   Int
  name     String    @db.NVarChar(80)
  make     Make      @relation(fields: [makeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicles Vehicle[]

  @@unique([makeId, name])
  @@map("VehicleModels")
}

model Transmission {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.NVarChar(60)
  vehicles Vehicle[]

  @@map("Transmissions")
}

model FuelType {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.NVarChar(60)
  vehicles Vehicle[]

  @@map("FuelTypes")
}

model DriveTrain {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(10) // AWD, FWD, RWD, 4WD
  description String    @db.NVarChar(80)
  vehicles    Vehicle[]

  @@map("DriveTrains")
}

model DamageLevel {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(10) // GREEN, YELLOW, RED
  name        String    @db.NVarChar(40)
  description String    @db.NVarChar(120)
  color       String    @db.NVarChar(10)
  vehicles    Vehicle[]

  @@map("DamageLevels")
}

// ---------------------------------------------------------------------------
// Vehículos / Subastas
// ---------------------------------------------------------------------------

model Vehicle {
  id             Int      @id @default(autoincrement())
  ownerId        Int
  year           Int
  itemTypeId     Int
  makeId         Int
  modelId        Int
  engine         String   @db.NVarChar(80)
  transmissionId Int
  fuelTypeId     Int
  driveTrainId   Int
  cylinders      Int
  damageLevelId  Int
  vin            String?  @db.NVarChar(30)
  mileage        Int?
  color          String?  @db.NVarChar(40)
  description    String?  @db.NVarChar(2000)

  // Parámetros de la subasta
  basePrice       Decimal   @db.Decimal(12, 2)
  startAt         DateTime
  endAt           DateTime
  currentBid      Decimal?  @db.Decimal(12, 2)
  currentBidderId Int?
  bidCount        Int       @default(0)
  // SCHEDULED | ACTIVE | SOLD | UNSOLD (se recalcula también con las fechas)
  status          String    @default("SCHEDULED") @db.NVarChar(12)
  closedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User         @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentBidder User?        @relation("VehicleCurrentBidder", fields: [currentBidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemType      ItemType     @relation(fields: [itemTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  make          Make         @relation(fields: [makeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model         VehicleModel @relation(fields: [modelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transmission  Transmission @relation(fields: [transmissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fuelType      FuelType     @relation(fields: [fuelTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driveTrain    DriveTrain   @relation(fields: [driveTrainId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  damageLevel   DamageLevel  @relation(fields: [damageLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  photos VehiclePhoto[]
  bids   Bid[]

  @@index([status, endAt])
  @@index([makeId, modelId])
  @@index([ownerId])
  @@map("Vehicles")
}

model VehiclePhoto {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  sortOrder Int     @default(0)
  // Una foto puede ser una URL externa o el binario subido por el usuario
  url       String? @db.NVarChar(500)
  mimeType  String? @db.NVarChar(40)
  data      Bytes?  @db.VarBinary(Max)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicleId, sortOrder])
  @@map("VehiclePhotos")
}

model Bid {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  userId    Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vehicleId, amount])
  @@index([userId])
  @@map("Bids")
}
