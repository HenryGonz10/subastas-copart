# Puerto HTTP del API
PORT=4000

# Cadena de conexión a SQL Server (Prisma)
# Local (docker compose up -d):
DATABASE_URL="sqlserver://localhost:1436;database=SubastasCopart;user=sa;password=Subastas#2026;encrypt=true;trustServerCertificate=true"
# Azure SQL Database:
# DATABASE_URL="sqlserver://<servidor>.database.windows.net:1433;database=<db>;user=<usuario>;password=<password>;encrypt=true;trustServerCertificate=false"

# Secreto para firmar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS / Socket.IO (separados por coma)
CORS_ORIGIN=http://localhost:5173
